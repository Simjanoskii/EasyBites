{
  "openapi": "3.0.3",
  "info": {
    "title": "EasyBites API",
    "version": "1.0.0",
    "description": "Milestone 3 development API for EasyBites. Authentication and role authorization are not part of this milestone; keep the API on a local development server."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8000",
      "description": "Local development server"
    }
  ],
  "tags": [
    { "name": "Users" },
    { "name": "Restaurants" },
    { "name": "Menu items" },
    { "name": "Orders" },
    { "name": "Order items" },
    { "name": "Reviews" },
    { "name": "Weather" },
    { "name": "Documentation" }
  ],
  "paths": {
    "/api/v1/users": {
      "get": {
        "tags": ["Users"],
        "summary": "List users",
        "responses": {
          "200": { "description": "User list.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserCollection" } } } },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "post": {
        "tags": ["Users"],
        "summary": "Create a customer account record",
        "description": "Passwords are hashed by the service; password hashes and role changes are never accepted or returned.",
        "requestBody": { "$ref": "#/components/requestBodies/CreateUser" },
        "responses": {
          "201": { "$ref": "#/components/responses/Created" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/v1/users/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/RecordId" }],
      "get": {
        "tags": ["Users"],
        "summary": "Get a user",
        "responses": {
          "200": { "description": "User record.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserEnvelope" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "put": {
        "tags": ["Users"],
        "summary": "Update user details",
        "description": "Role and password_hash fields are not writable; provide a new password value to change the hash.",
        "requestBody": { "$ref": "#/components/requestBodies/UpdateUser" },
        "responses": {
          "200": { "description": "Updated user record.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserEnvelope" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "delete": {
        "tags": ["Users"],
        "summary": "Delete a user",
        "responses": {
          "200": { "$ref": "#/components/responses/Deleted" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/v1/restaurants": {
      "get": {
        "tags": ["Restaurants"],
        "summary": "List restaurants",
        "responses": {
          "200": { "description": "Restaurant list.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RestaurantCollection" } } } },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "post": {
        "tags": ["Restaurants"],
        "summary": "Create a restaurant",
        "requestBody": { "$ref": "#/components/requestBodies/CreateRestaurant" },
        "responses": {
          "201": { "$ref": "#/components/responses/Created" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/v1/restaurants/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/RecordId" }],
      "get": {
        "tags": ["Restaurants"],
        "summary": "Get a restaurant",
        "responses": {
          "200": { "description": "Restaurant record.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RestaurantEnvelope" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "put": {
        "tags": ["Restaurants"],
        "summary": "Update a restaurant",
        "requestBody": { "$ref": "#/components/requestBodies/UpdateRestaurant" },
        "responses": {
          "200": { "description": "Updated restaurant record.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RestaurantEnvelope" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "delete": {
        "tags": ["Restaurants"],
        "summary": "Delete a restaurant",
        "responses": {
          "200": { "$ref": "#/components/responses/Deleted" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/v1/menu-items": {
      "get": {
        "tags": ["Menu items"],
        "summary": "List menu items",
        "responses": {
          "200": { "description": "Menu item list.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MenuItemCollection" } } } },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "post": {
        "tags": ["Menu items"],
        "summary": "Create a menu item",
        "requestBody": { "$ref": "#/components/requestBodies/CreateMenuItem" },
        "responses": {
          "201": { "$ref": "#/components/responses/Created" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/v1/menu-items/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/RecordId" }],
      "get": {
        "tags": ["Menu items"],
        "summary": "Get a menu item",
        "responses": {
          "200": { "description": "Menu item record.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MenuItemEnvelope" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "put": {
        "tags": ["Menu items"],
        "summary": "Update a menu item",
        "requestBody": { "$ref": "#/components/requestBodies/UpdateMenuItem" },
        "responses": {
          "200": { "description": "Updated menu item record.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MenuItemEnvelope" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "delete": {
        "tags": ["Menu items"],
        "summary": "Delete a menu item",
        "responses": {
          "200": { "$ref": "#/components/responses/Deleted" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/v1/orders": {
      "get": {
        "tags": ["Orders"],
        "summary": "List orders",
        "responses": {
          "200": { "description": "Order list.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrderCollection" } } } },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "post": {
        "tags": ["Orders"],
        "summary": "Create an order",
        "requestBody": { "$ref": "#/components/requestBodies/CreateOrder" },
        "responses": {
          "201": { "$ref": "#/components/responses/Created" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/v1/orders/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/RecordId" }],
      "get": {
        "tags": ["Orders"],
        "summary": "Get an order",
        "responses": {
          "200": { "description": "Order record.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrderEnvelope" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "put": {
        "tags": ["Orders"],
        "summary": "Update an order",
        "requestBody": { "$ref": "#/components/requestBodies/UpdateOrder" },
        "responses": {
          "200": { "description": "Updated order record.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrderEnvelope" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "delete": {
        "tags": ["Orders"],
        "summary": "Delete an order",
        "responses": {
          "200": { "$ref": "#/components/responses/Deleted" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/v1/order-items": {
      "get": {
        "tags": ["Order items"],
        "summary": "List order items",
        "responses": {
          "200": { "description": "Order item list.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrderItemCollection" } } } },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "post": {
        "tags": ["Order items"],
        "summary": "Create an order item",
        "requestBody": { "$ref": "#/components/requestBodies/CreateOrderItem" },
        "responses": {
          "201": { "$ref": "#/components/responses/Created" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/v1/order-items/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/RecordId" }],
      "get": {
        "tags": ["Order items"],
        "summary": "Get an order item",
        "responses": {
          "200": { "description": "Order item record.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrderItemEnvelope" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "put": {
        "tags": ["Order items"],
        "summary": "Update an order item",
        "requestBody": { "$ref": "#/components/requestBodies/UpdateOrderItem" },
        "responses": {
          "200": { "description": "Updated order item record.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrderItemEnvelope" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "delete": {
        "tags": ["Order items"],
        "summary": "Delete an order item",
        "responses": {
          "200": { "$ref": "#/components/responses/Deleted" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/v1/reviews": {
      "get": {
        "tags": ["Reviews"],
        "summary": "List reviews",
        "responses": {
          "200": { "description": "Review list.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReviewCollection" } } } },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "post": {
        "tags": ["Reviews"],
        "summary": "Create a review",
        "requestBody": { "$ref": "#/components/requestBodies/CreateReview" },
        "responses": {
          "201": { "$ref": "#/components/responses/Created" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/v1/reviews/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/RecordId" }],
      "get": {
        "tags": ["Reviews"],
        "summary": "Get a review",
        "responses": {
          "200": { "description": "Review record.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReviewEnvelope" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "put": {
        "tags": ["Reviews"],
        "summary": "Update a review",
        "requestBody": { "$ref": "#/components/requestBodies/UpdateReview" },
        "responses": {
          "200": { "description": "Updated review record.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReviewEnvelope" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "delete": {
        "tags": ["Reviews"],
        "summary": "Delete a review",
        "responses": {
          "200": { "$ref": "#/components/responses/Deleted" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/v1/weather/sarajevo": {
      "get": {
        "tags": ["Weather"],
        "summary": "Get current Sarajevo weather and dining advice",
        "description": "Returns normalized current conditions from Open-Meteo and a practical local dining suggestion. A 503 is returned if the provider is unavailable or its response is invalid.",
        "responses": {
          "200": { "description": "Current weather and dining advice.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WeatherEnvelope" } } } },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "tags": ["Documentation"],
        "summary": "Get the OpenAPI document",
        "responses": {
          "200": { "description": "OpenAPI 3.0 JSON document.", "content": { "application/json": { "schema": { "type": "object" } } } },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/docs": {
      "get": {
        "tags": ["Documentation"],
        "summary": "Open interactive Swagger UI",
        "responses": {
          "200": { "description": "Swagger UI page.", "content": { "text/html": { "schema": { "type": "string" } } } }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "RecordId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Positive integer record ID.",
        "schema": { "type": "integer", "minimum": 1 }
      }
    },
    "responses": {
      "Created": {
        "description": "Record created.",
        "headers": { "Location": { "schema": { "type": "string" }, "description": "URL of the created record." } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreatedEnvelope" } } }
      },
      "Deleted": {
        "description": "Record deleted.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeletedEnvelope" } } }
      },
      "BadRequest": {
        "description": "Malformed JSON, invalid input, or a database constraint violation.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
      },
      "NotFound": {
        "description": "The requested record does not exist.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
      },
      "ServerError": {
        "description": "Unexpected server or database failure. Internal details are not returned.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
      },
      "Unavailable": {
        "description": "The weather provider timed out, failed, or returned invalid data.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
      }
    },
    "requestBodies": {
      "CreateUser": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateUser" } } } },
      "UpdateUser": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateUser" } } } },
      "CreateRestaurant": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateRestaurant" } } } },
      "UpdateRestaurant": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateRestaurant" } } } },
      "CreateMenuItem": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateMenuItem" } } } },
      "UpdateMenuItem": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateMenuItem" } } } },
      "CreateOrder": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateOrder" } } } },
      "UpdateOrder": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateOrder" } } } },
      "CreateOrderItem": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateOrderItem" } } } },
      "UpdateOrderItem": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateOrderItem" } } } },
      "CreateReview": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateReview" } } } },
      "UpdateReview": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateReview" } } } }
    },
    "schemas": {
      "ErrorEnvelope": {
        "type": "object",
        "required": ["error"],
        "properties": { "error": { "type": "string" } }
      },
      "CreatedEnvelope": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "object", "required": ["id"], "properties": { "id": { "type": "integer", "minimum": 1 } } } }
      },
      "DeletedEnvelope": {
        "type": "object",
        "required": ["message"],
        "properties": { "message": { "type": "string", "example": "Record deleted." } }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "full_name": { "type": "string", "maxLength": 120 },
          "email": { "type": "string", "format": "email", "maxLength": 254 },
          "role": { "type": "string", "enum": ["customer", "admin"] },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "CreateUser": {
        "type": "object",
        "required": ["full_name", "email", "password"],
        "additionalProperties": false,
        "properties": {
          "full_name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "email": { "type": "string", "format": "email", "maxLength": 254 },
          "password": { "type": "string", "format": "password", "minLength": 8, "maxLength": 128, "writeOnly": true }
        }
      },
      "UpdateUser": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": false,
        "properties": {
          "full_name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "email": { "type": "string", "format": "email", "maxLength": 254 },
          "password": { "type": "string", "format": "password", "minLength": 8, "maxLength": 128, "writeOnly": true }
        }
      },
      "Restaurant": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string", "maxLength": 150 },
          "description": { "type": "string", "nullable": true, "maxLength": 16000 },
          "address": { "type": "string", "maxLength": 255 },
          "phone": { "type": "string", "nullable": true, "maxLength": 32 },
          "is_active": { "type": "integer", "enum": [0, 1] },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "CreateRestaurant": {
        "type": "object",
        "required": ["name", "address"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 150 },
          "description": { "type": "string", "nullable": true, "maxLength": 16000 },
          "address": { "type": "string", "minLength": 1, "maxLength": 255 },
          "phone": { "type": "string", "nullable": true, "maxLength": 32 },
          "is_active": { "type": "boolean", "default": true }
        }
      },
      "UpdateRestaurant": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 150 },
          "description": { "type": "string", "nullable": true, "maxLength": 16000 },
          "address": { "type": "string", "minLength": 1, "maxLength": 255 },
          "phone": { "type": "string", "nullable": true, "maxLength": 32 },
          "is_active": { "type": "boolean" }
        }
      },
      "MenuItem": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "restaurant_id": { "type": "integer", "minimum": 1 },
          "name": { "type": "string", "maxLength": 150 },
          "description": { "type": "string", "nullable": true, "maxLength": 16000 },
          "category": { "type": "string", "maxLength": 60 },
          "price": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$", "example": "12.50" },
          "is_available": { "type": "integer", "enum": [0, 1] },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "CreateMenuItem": {
        "type": "object",
        "required": ["restaurant_id", "name", "category", "price"],
        "additionalProperties": false,
        "properties": {
          "restaurant_id": { "type": "integer", "minimum": 1 },
          "name": { "type": "string", "minLength": 1, "maxLength": 150 },
          "description": { "type": "string", "nullable": true, "maxLength": 16000 },
          "category": { "type": "string", "minLength": 1, "maxLength": 60 },
          "price": { "type": "number", "minimum": 0, "multipleOf": 0.01 },
          "is_available": { "type": "boolean", "default": true }
        }
      },
      "UpdateMenuItem": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": false,
        "properties": {
          "restaurant_id": { "type": "integer", "minimum": 1 },
          "name": { "type": "string", "minLength": 1, "maxLength": 150 },
          "description": { "type": "string", "nullable": true, "maxLength": 16000 },
          "category": { "type": "string", "minLength": 1, "maxLength": 60 },
          "price": { "type": "number", "minimum": 0, "multipleOf": 0.01 },
          "is_available": { "type": "boolean" }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "user_id": { "type": "integer", "minimum": 1 },
          "restaurant_id": { "type": "integer", "minimum": 1 },
